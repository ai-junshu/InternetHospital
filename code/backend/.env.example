# backend 本地环境（引用 code/infra/.env 中的连接串）
APP_NAME=互联网医疗中心平台后端
API_V1_PREFIX=/api/v1
DEBUG=true

# 数据库连接（与 code/infra/docker-compose.yml 中的 PG_*/MONGO_*/CLICKHOUSE_* 保持一致）
POSTGRES_URI=postgresql+asyncpg://ihm:ihm_dev_pwd@localhost:5432/ihm
REDIS_URI=redis://localhost:6379/0
MONGO_URI=mongodb://ihm:ihm_dev_pwd@localhost:27017/ihm?authSource=admin
CLICKHOUSE_URI=clickhouse://ihm:ihm_dev_pwd@localhost:8123/ihm

# 鉴权：生产必须由环境变量注入真实密钥，禁止提交 .env
# 生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 防重放（timestamp + nonce + sign，5 分钟窗口）
REPLAY_WINDOW_SECONDS=300

# CORS（本地开发前端端口）
CORS_ORIGINS=http://localhost:3000,http://localhost:10086

# 微信支付（APIv3 JSAPI，生产开启前必须配置真实凭证并置 WXPAY_DEV_SANDBOX=false）
WXPAY_MCH_ID=your-merchant-id
WXPAY_API_V3_KEY=your-32byte-apiv3-key
WXPAY_CERT_SERIAL=your-merchant-cert-serial
WXPAY_APPID=wx-your-miniprogram-appid
# 商户 API 私钥 pem 文件路径（PKCS#8，含 -----BEGIN PRIVATE KEY-----），禁止硬编码
WXPAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
# 平台证书缓存目录（自动下载的微信平台证书按 serial 缓存为 pem）
WXPAY_CERT_CACHE_DIR=./.cache/wxpay_certs
# 支付回调基础地址（微信服务器回调用），如 https://api.example.com
WXPAY_NOTIFY_BASE_URL=https://api.example.com
# dev 沙箱开关：true=跳过真实微信调用与回调验签（本地联调用）；生产必须=false
WXPAY_DEV_SANDBOX=true

# 合理用药引擎（默认 local 内置本地真引擎，零外部依赖）
#   local = 内置临床知识库真引擎（相互作用/禁忌/重复用药/特殊人群/剂量告警）
#   http  = 第三方供应商对接（需配 RX_ENGINE_BASE_URL）
#   mock  = 最小规则集，仅作降级基准
RX_ENGINE_PROVIDER=local
# RX_ENGINE_BASE_URL=https://rx.example.com
# 可选：外置 JSON 知识库路径，覆盖内置规则集（留空用内置 DEFAULT_KB）
# RX_ENGINE_KB_PATH=./rx_kb.json
