# backend 本地环境（引用 code/infra/.env 中的连接串）
APP_NAME=互联网医疗中心平台后端
API_V1_PREFIX=/api/v1
DEBUG=true

# 数据库连接
POSTGRES_URI=postgresql+asyncpg://ihm:ihm_dev_pwd@localhost:5432/ihm
REDIS_URI=redis://localhost:6379/0
MONGO_URI=mongodb://ihm:ihm_dev_pwd@localhost:27017/ihm?authSource=admin
CLICKHOUSE_URI=clickhouse://ihm:ihm_dev_pwd@localhost:8123/ihm

# 鉴权（真实密钥经环境变量注入，技术架构第14.5章，禁止入库）
# ⚠️ 本地 dev 占位（32 字节强随机串）。生产部署必须替换为 openssl rand -hex 32 生成的真实密钥。
JWT_SECRET=9f2a7c4e1b8d6a3f5c0e9d2b7a4f1c8e3b6d9a2f5c8e1b4d7a0f3c6e9b2d5a8f
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 防重放（技术架构第10.2章：timestamp + nonce + sign，5 分钟窗口）
REPLAY_WINDOW_SECONDS=300

# CORS（本地开发前端端口）
CORS_ORIGINS=http://localhost:3000,http://localhost:10086

# ---------------- P5 性能容灾：Redis 缓存 / 接口限流 ----------------
# 缓存默认 TTL（秒）
CACHE_DEFAULT_TTL=60
# 接口限流总开关
RATE_LIMIT_ENABLED=true
# 固定窗口时长（秒）
RATE_LIMIT_WINDOW_SECONDS=60
# 每 IP 每窗口最大请求数
RATE_LIMIT_PER_IP_PER_MIN=120
# 每用户（JWT sub）每窗口最大请求数
RATE_LIMIT_PER_USER_PER_MIN=300
# 限流白名单路径（逗号分隔，精确前缀匹配）
RATE_LIMIT_WHITELIST_PATHS=/health,/docs,/redoc,/openapi.json
