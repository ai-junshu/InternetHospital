# 互联网医疗中心平台 · 本地环境变量模板
# 复制本文件为 .env 并填入本地值（真实密钥禁止入库，见第14.5章）
# 用法：在 code/infra 目录 `cp .env.example .env` 后 `docker compose up -d`

# ---------- PostgreSQL (+pgvector) ----------
PG_USER=ihm
PG_PASSWORD=ihm_dev_pwd
PG_DATABASE=ihm
PG_PORT=5432
# backend/ai-service 连接串（技术架构第11章）
POSTGRES_URI=postgresql+asyncpg://ihm:ihm_dev_pwd@localhost:5432/ihm

# ---------- Redis ----------
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URI=redis://localhost:6379/0

# ---------- MongoDB ----------
MONGO_USER=ihm
MONGO_PASSWORD=ihm_dev_pwd
MONGO_DATABASE=ihm
MONGO_PORT=27017
MONGO_URI=mongodb://ihm:ihm_dev_pwd@localhost:27017/ihm?authSource=admin

# ---------- ClickHouse ----------
CLICKHOUSE_USER=ihm
CLICKHOUSE_PASSWORD=ihm_dev_pwd
CLICKHOUSE_DB=ihm
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=19000
CLICKHOUSE_URI=clickhouse://ihm:ihm_dev_pwd@localhost:8123/ihm

# ---------- MinIO (对象存储) ----------
MINIO_ROOT_USER=ihm
MINIO_ROOT_PASSWORD=ihm_dev_pwd
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=ihm-private

# ---------- 可观测 ----------
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP=http://localhost:4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---------- 后端/AI 共享（由各仓库 .env 实际引用，这里仅作约定参考） ----------
# JWT_SECRET=change-me-in-real-deploy
# JWT_ALGORITHM=HS256
# API_V1_PREFIX=/api/v1
# CORS_ORIGINS=http://localhost:3000,http://localhost:10086
# CACHE_DEFAULT_TTL=60
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_PER_IP_PER_MIN=120
# RATE_LIMIT_PER_USER_PER_MIN=300
# RATE_LIMIT_WHITELIST_PATHS=/health,/docs,/redoc,/openapi.json
